+            bool load = xo == 597;
+            println("\t{{");
+            println("\t\tuint32_t ea = {};", ra == 0 ? std::string("0u") : r(ra) + ".u32");
+            for (uint32_t i = 0; i < nb; i++)
+            {
+                uint32_t reg = (rd + i / 4) % 32;
+                uint32_t shift = 24 - 8 * (i % 4);
+                if (load)
+                {
+                    if (i % 4 == 0)
+                        println("\t\t{}.u64 = 0;", r(reg));
+                    println("\t\t{}.u32 |= uint32_t(PPC_LOAD_U8(ea + {}u)) << {};", r(reg), i, shift);
+                }
+                else
+                    println("\t\tPPC_STORE_U8(ea + {}u, uint8_t({}.u32 >> {}));", i, r(reg), shift);
+            }
+            println("\t}}");
+            return true;
+        }
+        default:
+            break;
+        }
+
+        uint32_t xo9 = (word >> 1) & 511;
+        if (xo9 == 232) // subfme
+        {
+            println("\t{{ uint64_t t = uint64_t(~{}.u32) + ctx.xer.ca + 0xFFFFFFFFull; ctx.xer.ca = t >> 32; {}.u64 = uint32_t(t); }}", r(ra), r(rd));

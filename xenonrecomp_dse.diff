--- /dev/null
+++ b/XenonRecomp/gekko.cpp
@@ -0,0 +1,476 @@
+// Gekko/Broadway (GameCube/Wii) instructions for XenonRecomp.
+//
+// On the Wii, primary opcode 4 holds the paired-single instructions (on the Xbox 360 it is VMX),
+// and opcodes 56/57/60/61 are the quantized loads/stores psq_l, psq_lu, psq_st, psq_stu.
+// Each FPR holds two values: ps0 is ctx.fN.f64 and ps1 is ctx.ps1[N].
+// The quantization registers GQR0-7 are SPRs 912-919, stored in ctx.spr[912..919].
+//
+// Semantics follow the Gekko user manual and Dolphin's interpreter.
+// The emitter assumes registers live in ctx (all *_as_local options off).
+
+#include "pch.h"
+#include "recompiler.h"
+
+namespace
+{
+    struct Fields
+    {
+        uint32_t word;
+        uint32_t d() const { return (word >> 21) & 31; }
+        uint32_t a() const { return (word >> 16) & 31; }
+        uint32_t b() const { return (word >> 11) & 31; }
+        uint32_t c() const { return (word >> 6) & 31; }
+        bool rc() const { return word & 1; }
+    };
+
+    std::string ps0(uint32_t n) { return fmt::format("ctx.f{}.f64", n); }
+    std::string ps1(uint32_t n) { return fmt::format("ctx.ps1[{}]", n); }
+    std::string gpr(uint32_t n) { return fmt::format("ctx.r{}.u32", n); }
+}
+
+bool Recompiler::IsGekkoInstruction(uint32_t word)
+{
+    uint32_t op = word >> 26;
+    return op == 4 || op == 56 || op == 57 || op == 60 || op == 61;
+}
+
+bool Recompiler::RecompileGekko(uint32_t word, uint32_t address)
+{
+    Fields i{ word };
+    uint32_t op = word >> 26;
+
+    // psq_l / psq_lu / psq_st / psq_stu: d(rA) with a 12-bit signed displacement.
+    if (op != 4)
+    {
+        int32_t disp = int32_t(word << 20) >> 20;
+        uint32_t w = (word >> 15) & 1;
+        uint32_t q = (word >> 12) & 7;
+        bool update = op == 57 || op == 61;
+        bool store = op >= 60;
+        q += 912; // GQR0-7 are SPRs 912-919
+        println("\t// {} f{}, {}(r{}), {}, qr{}", store ? (update ? "psq_stu" : "psq_st") : (update ? "psq_lu" : "psq_l"),
+            i.d(), disp, i.a(), w, q - 912);
+        println("\t{{");
+        if (i.a() == 0 && !update)
+            println("\t\tuint32_t ea = {}u;", uint32_t(disp));
+        else
+            println("\t\tuint32_t ea = {} + {}u;", gpr(i.a()), uint32_t(disp));
+        if (store)
+        {
+            println("\t\tPPC_PSQ_STORE(ea, ctx.spr[{}], 0, {});", q, ps0(i.d()));
+            if (!w)
+                println("\t\tPPC_PSQ_STORE(ea, ctx.spr[{}], 1, {});", q, ps1(i.d()));
+        }
+        else
+        {
+            println("\t\tdouble v0 = PPC_PSQ_LOAD(ea, ctx.spr[{}], 0);", q);
+            println("\t\tdouble v1 = {};", w ? "1.0" : fmt::format("PPC_PSQ_LOAD(ea, ctx.spr[{}], 1)", q));
+            println("\t\t{} = v0; {} = v1;", ps0(i.d()), ps1(i.d()));
+        }
+        if (update)
+            println("\t\t{} = ea;", gpr(i.a()));
+        println("\t}}");
+        return true;
+    }
+
+    uint32_t x5 = (word >> 1) & 31;
+    uint32_t x6 = (word >> 1) & 63;
+    uint32_t x10 = (word >> 1) & 1023;
+    uint32_t d = i.d(), a = i.a(), b = i.b(), c = i.c();
+
+    // Arithmetic in single precision: compute both halves into temporaries first,
+    // since the destination may also be a source.
+    auto pair = [&](const char* name, const std::string& r0, const std::string& r1)
+        {
+            println("\t// {} f{}, f{}, f{}, f{}", name, d, a, b, c);
+            println("\t{{");
+            println("\t\tdouble t0 = double(float({}));", r0);
+            println("\t\tdouble t1 = double(float({}));", r1);
+            println("\t\t{} = t0; {} = t1;", ps0(d), ps1(d));
+            println("\t}}");
+            return true;
+        };
+
+    switch (x5)
+    {
+    case 18: return pair("ps_div", ps0(a) + " / " + ps0(b), ps1(a) + " / " + ps1(b));
+    case 20: return pair("ps_sub", ps0(a) + " - " + ps0(b), ps1(a) + " - " + ps1(b));
+    case 21: return pair("ps_add", ps0(a) + " + " + ps0(b), ps1(a) + " + " + ps1(b));
+    case 23:
+        return pair("ps_sel", fmt::format("{} >= 0.0 ? {} : {}", ps0(a), ps0(c), ps0(b)),
+            fmt::format("{} >= 0.0 ? {} : {}", ps1(a), ps1(c), ps1(b)));
+    case 24: return pair("ps_res", "1.0 / " + ps0(b), "1.0 / " + ps1(b));
+    case 25: return pair("ps_mul", ps0(a) + " * " + ps0(c), ps1(a) + " * " + ps1(c));
+    case 26: return pair("ps_rsqrte", "1.0 / sqrt(" + ps0(b) + ")", "1.0 / sqrt(" + ps1(b) + ")");
+    case 28: return pair("ps_msub", ps0(a) + " * " + ps0(c) + " - " + ps0(b), ps1(a) + " * " + ps1(c) + " - " + ps1(b));
+    case 29: return pair("ps_madd", ps0(a) + " * " + ps0(c) + " + " + ps0(b), ps1(a) + " * " + ps1(c) + " + " + ps1(b));
+    case 30: return pair("ps_nmsub", "-(" + ps0(a) + " * " + ps0(c) + " - " + ps0(b) + ")", "-(" + ps1(a) + " * " + ps1(c) + " - " + ps1(b) + ")");
+    case 31: return pair("ps_nmadd", "-(" + ps0(a) + " * " + ps0(c) + " + " + ps0(b) + ")", "-(" + ps1(a) + " * " + ps1(c) + " + " + ps1(b) + ")");
+    case 10: return pair("ps_sum0", ps0(a) + " + " + ps1(b), ps1(c));
+    case 11: return pair("ps_sum1", ps0(c), ps0(a) + " + " + ps1(b));
+    case 12: return pair("ps_muls0", ps0(a) + " * " + ps0(c), ps1(a) + " * " + ps0(c));
+    case 13: return pair("ps_muls1", ps0(a) + " * " + ps1(c), ps1(a) + " * " + ps1(c));
+    case 14: return pair("ps_madds0", ps0(a) + " * " + ps0(c) + " + " + ps0(b), ps1(a) + " * " + ps0(c) + " + " + ps1(b));
+    case 15: return pair("ps_madds1", ps0(a) + " * " + ps1(c) + " + " + ps0(b), ps1(a) + " * " + ps1(c) + " + " + ps1(b));
+    default: break;
+    }
+
+    // Indexed quantized loads/stores: (rA|0) + rB, with W and I in different bits.
+    if (x6 == 6 || x6 == 7 || x6 == 38 || x6 == 39)
+    {
+        uint32_t w = (word >> 10) & 1;
+        uint32_t q = (word >> 7) & 7;
+        bool update = x6 >= 38;
+        bool store = x6 == 7 || x6 == 39;
+        q += 912; // GQR0-7 are SPRs 912-919
+        println("\t// {} f{}, r{}, r{}, {}, qr{}", store ? (update ? "psq_stux" : "psq_stx") : (update ? "psq_lux" : "psq_lx"),
+            d, a, b, w, q - 912);
+        println("\t{{");
+        if (a == 0 && !update)
+            println("\t\tuint32_t ea = {};", gpr(b));
+        else
+            println("\t\tuint32_t ea = {} + {};", gpr(a), gpr(b));
+        if (store)
+        {
+            println("\t\tPPC_PSQ_STORE(ea, ctx.spr[{}], 0, {});", q, ps0(d));
+            if (!w)
+                println("\t\tPPC_PSQ_STORE(ea, ctx.spr[{}], 1, {});", q, ps1(d));
+        }
+        else
+        {
+            println("\t\tdouble v0 = PPC_PSQ_LOAD(ea, ctx.spr[{}], 0);", q);
+            println("\t\tdouble v1 = {};", w ? "1.0" : fmt::format("PPC_PSQ_LOAD(ea, ctx.spr[{}], 1)", q));
+            println("\t\t{} = v0; {} = v1;", ps0(d), ps1(d));
+        }
+        if (update)
+            println("\t\t{} = ea;", gpr(a));
+        println("\t}}");
+        return true;
+    }
+
+    // Moves without rounding.
+    auto move = [&](const char* name, const std::string& r0, const std::string& r1)
+        {
+            println("\t// {} f{}, f{}, f{}", name, d, a, b);
+            println("\t{{");
+            println("\t\tdouble t0 = {};", r0);
+            println("\t\tdouble t1 = {};", r1);
+            println("\t\t{} = t0; {} = t1;", ps0(d), ps1(d));
+            println("\t}}");
+            return true;
+        };
+
+    // Floating-point compare into a CR field (crfD is bits 6-8).
+    auto compare = [&](const char* name, const std::string& l, const std::string& r)
+        {
+            uint32_t crf = (word >> 23) & 7;
+            println("\t// {} cr{}, f{}, f{}", name, crf, a, b);
+            println("\tctx.cr{}.compare({}, {});", crf, l, r);
+            return true;
+        };
+
+    switch (x10)
+    {
+    case 0: return compare("ps_cmpu0", ps0(a), ps0(b));
+    case 32: return compare("ps_cmpo0", ps0(a), ps0(b));
+    case 64: return compare("ps_cmpu1", ps1(a), ps1(b));
+    case 96: return compare("ps_cmpo1", ps1(a), ps1(b));
+    case 40: return move("ps_neg", "-" + ps0(b), "-" + ps1(b));
+    case 72: return move("ps_mr", ps0(b), ps1(b));
+    case 136: return move("ps_nabs", "-fabs(" + ps0(b) + ")", "-fabs(" + ps1(b) + ")");
+    case 264: return move("ps_abs", "fabs(" + ps0(b) + ")", "fabs(" + ps1(b) + ")");
+    case 528: return move("ps_merge00", ps0(a), ps0(b));
+    case 560: return move("ps_merge01", ps0(a), ps1(b));
+    case 592: return move("ps_merge10", ps1(a), ps0(b));
+    case 624: return move("ps_merge11", ps1(a), ps1(b));
+    case 1014:
+        // dcbz_l: clear a 32-byte line of the locked cache.
+        println("\t// dcbz_l r{}, r{}", a, b);
+        if (a == 0)
+            println("\tmemset(base + ({} & ~31u), 0, 32);", gpr(b));
+        else
+            println("\tmemset(base + (({} + {}) & ~31u), 0, 32);", gpr(a), gpr(b));
+        return true;
+    default:
+        break;
+    }
+
+    fmt::println("Unrecognized Gekko instruction {:08X} at 0x{:X}", word, address);
+    return false;
+}
+
+namespace
+{
+    // CR bit b lives in field b/4: 0 lt, 1 gt, 2 eq, 3 so.
+    std::string crbit(uint32_t b)
+    {
+        static const char* names[] = { "lt", "gt", "eq", "so" };
+        return fmt::format("ctx.cr{}.{}", b / 4, names[b % 4]);
+    }
+
+    int32_t simm16(uint32_t word) { return int16_t(word & 0xFFFF); }
+
+    std::string rotlMask(uint32_t mb, uint32_t me)
+    {
+        uint32_t mask = mb <= me ? ((0xFFFFFFFFu >> mb) & (0xFFFFFFFFu << (31 - me)))
+                                 : ((0xFFFFFFFFu >> mb) | (0xFFFFFFFFu << (31 - me)));
+        return fmt::format("0x{:08X}u", mask);
+    }
+}
+
+bool Recompiler::RecompileWiiExtra(uint32_t word, uint32_t address)
+{
+    uint32_t op = word >> 26;
+    uint32_t rd = (word >> 21) & 31, ra = (word >> 16) & 31, rb = (word >> 11) & 31;
+    uint32_t xo = (word >> 1) & 1023;
+    auto r = [](uint32_t n) { return fmt::format("ctx.r{}", n); };
+    auto f = [](uint32_t n) { return fmt::format("ctx.f{}", n); };
+    auto eaDisp = [&](uint32_t base, int32_t disp)
+        {
+            return base == 0 ? fmt::format("{}u", uint32_t(disp)) : fmt::format("{}.u32 + {}u", r(base), uint32_t(disp));
+        };
+    auto eaIndexed = [&]()
+        {
+            return ra == 0 ? fmt::format("{}.u32", r(rb)) : fmt::format("{}.u32 + {}.u32", r(ra), r(rb));
+        };
+
+    // Condition register logic (opcode 19).
+    if (op == 19)
+    {
+        const char* expr = nullptr;
+        switch (xo)
+        {
+        case 257: expr = "{a} & {b}"; break;          // crand
+        case 129: expr = "{a} & !{b}"; break;         // crandc
+        case 289: expr = "!({a} ^ {b})"; break;       // creqv / crset
+        case 225: expr = "!({a} & {b})"; break;       // crnand
+        case 33:  expr = "!({a} | {b})"; break;       // crnor / crnot
+        case 449: expr = "{a} | {b}"; break;          // cror / crmove
+        case 417: expr = "{a} | !{b}"; break;         // crorc
+        case 193: expr = "{a} ^ {b}"; break;          // crxor / crclr
+        default: break;
+        }
+        if (expr != nullptr)
+        {
+            std::string e = fmt::format(fmt::runtime(expr), fmt::arg("a", crbit(ra)), fmt::arg("b", crbit(rb)));
+            println("\t{} = uint8_t({});", crbit(rd), e);
+            return true;
+        }
+        if (xo == 0) // mcrf
+        {
+            println("\tctx.cr{} = ctx.cr{};", rd >> 2, ra >> 2);
+            return true;
+        }
+        if (xo == 150) // isync
+            return true;
+        if (xo == 50) // rfi: only in SDK exception handlers, which the runtime replaces
+        {
+            println("\treturn;");
+            return true;
+        }
+    }
+
+    if (op == 63)
+    {
+        if (xo == 32) // fcmpo: same result as fcmpu for our purposes
+        {
+            println("\tctx.cr{}.compare({}.f64, {}.f64);", rd >> 2, f(ra), f(rb));
+            return true;
+        }
+        if (xo == 14) // fctiw: round with the current mode (nearest)
+        {
+            println("\t{}.s64 = ({}.f64 > double(INT_MAX)) ? INT_MAX : ({}.f64 < double(INT_MIN)) ? INT_MIN : int32_t(std::nearbyint({}.f64));",
+                f(rd), f(rb), f(rb), f(rb));
+            return true;
+        }
+        if (xo == 64) // mcrfs
+        {
+            println("\tctx.cr{}.lt = ctx.cr{}.gt = ctx.cr{}.eq = ctx.cr{}.so = 0;", rd >> 2, rd >> 2, rd >> 2, rd >> 2);
+            return true;
+        }
+        if (xo == 70 || xo == 38 || xo == 134) // mtfsb0, mtfsb1, mtfsfi: exception/rounding bits, ignored
+            return true;
+    }
+
+    if (op == 23) // rlwnm
+    {
+        uint32_t mb = (word >> 6) & 31, me = (word >> 1) & 31;
+        println("\t{}.u64 = __builtin_rotateleft32({}.u32, {}.u8 & 0x1F) & {};", r(ra), r(rd), r(rb), rotlMask(mb, me));
+        if (word & 1)
+            println("\tctx.cr0.compare<int32_t>({}.s32, 0, ctx.xer);", r(ra));
+        return true;
+    }
+
+    if (op == 46 || op == 47) // lmw / stmw
+    {
+        println("\t{{");
+        println("\t\tuint32_t ea = {};", eaDisp(ra, simm16(word)));
+        for (uint32_t n = rd; n < 32; n++)
+        {
+            if (op == 46)
+                println("\t\t{}.u64 = PPC_LOAD_U32(ea + {}u);", r(n), (n - rd) * 4);
+            else
+                println("\t\tPPC_STORE_U32(ea + {}u, {}.u32);", (n - rd) * 4, r(n));
+        }
+        println("\t}}");
+        return true;
+    }
+
+    if (op == 3) // twi
+    {
+        println("\tif (PPC_TRAP_TEST({}, {}.s32, {})) PPC_TRAP(0x{:X});", rd, r(ra), simm16(word), address);
+        return true;
+    }
+
+    if (op == 17) // sc
+    {
+        println("\tPPC_SYSCALL(0x{:X});", address);
+        return true;
+    }
+
+    if (op == 31)
+    {
+        uint32_t spr = ((word >> 16) & 31) | (((word >> 11) & 31) << 5);
+        switch (xo)
+        {
+        case 467: // mtspr
+            if (spr == 1)
+            {
+                println("\tctx.xer.so = ({}.u32 >> 31) & 1; ctx.xer.ov = ({}.u32 >> 30) & 1; ctx.xer.ca = ({}.u32 >> 29) & 1;", r(rd), r(rd), r(rd));
+            }
+            else if (spr == 8)
+                println("\tctx.lr = {}.u32;", r(rd));
+            else if (spr == 9)
+                println("\tctx.ctr.u64 = {}.u32;", r(rd));
+            else if (spr == 923)
+            {
+                // DMA_L: writing it with the trigger bit starts a locked-cache DMA
+                // (with DMA_U, SPR 922). The copy is done at once.
+                println("\tctx.spr[923] = {}.u32;", r(rd));
+                println("\tif (ctx.spr[923] & 2) {{ PPC_LC_DMA(ctx.spr[922], ctx.spr[923]); ctx.spr[923] &= ~2u; }}");
+            }
+            else
+                println("\tctx.spr[{}] = {}.u32;", spr, r(rd));
+            return true;
+        case 339: // mfspr
+            if (spr == 1)
+                println("\t{}.u64 = (uint32_t(ctx.xer.so) << 31) | (uint32_t(ctx.xer.ov) << 30) | (uint32_t(ctx.xer.ca) << 29);", r(rd));
+            else if (spr == 8)
+                println("\t{}.u64 = uint32_t(ctx.lr);", r(rd));
+            else if (spr == 9)
+                println("\t{}.u64 = ctx.ctr.u32;", r(rd));
+            else
+                println("\t{}.u64 = ctx.spr[{}];", r(rd), spr);
+            return true;
+        case 146: // mtmsr
+            println("\tctx.msr = {}.u32;", r(rd));
+            return true;
+        case 210: case 242: // mtsr, mtsrin: segment registers, unused on the Wii
+            return true;
+        case 595: case 659: // mfsr, mfsrin
+            println("\t{}.u64 = 0;", r(rd));
+            return true;
+        case 512: // mcrxr
+            println("\tctx.cr{}.lt = ctx.xer.so; ctx.cr{}.gt = ctx.xer.ov; ctx.cr{}.eq = ctx.xer.ca; ctx.cr{}.so = 0;",
+                rd >> 2, rd >> 2, rd >> 2, rd >> 2);
+            println("\tctx.xer.so = ctx.xer.ov = ctx.xer.ca = 0;");
+            return true;
+        case 144: // mtcrf
+        {
+            uint32_t fxm = (word >> 12) & 0xFF;
+            for (uint32_t i = 0; i < 8; i++)
+            {
+                if (fxm & (0x80 >> i))
+                {
+                    uint32_t sh = 31 - 4 * i;
+                    println("\tctx.cr{}.lt = ({}.u32 >> {}) & 1; ctx.cr{}.gt = ({}.u32 >> {}) & 1; ctx.cr{}.eq = ({}.u32 >> {}) & 1; ctx.cr{}.so = ({}.u32 >> {}) & 1;",
+                        i, r(rd), sh, i, r(rd), sh - 1, i, r(rd), sh - 2, i, r(rd), sh - 3);
+                }
+            }
+            return true;
+        }
+        case 4: // tw
+            println("\tif (PPC_TRAP_TEST_REG({}, {}.s32, {}.s32)) PPC_TRAP(0x{:X});", rd, r(ra), r(rb), address);
+            return true;
+        case 306: case 566: case 470: case 982: case 310: case 438: // tlbie tlbsync dcbi icbi eciwx ecowx
+            return true;
+        case 375: // lhaux
+            println("\t{{ uint32_t ea = {}; {}.s64 = int16_t(PPC_LOAD_U16(ea)); {}.u32 = ea; }}", eaIndexed(), r(rd), r(ra));
+            return true;
+        case 631: // lfdux
+            println("\t{{ uint32_t ea = {}; {}.u64 = PPC_LOAD_U64(ea); ctx.ps1[{}] = {}.f64; {}.u32 = ea; }}", eaIndexed(), f(rd), rd, f(rd), r(ra));
+            return true;
+        case 759: // stfdux
+            println("\t{{ uint32_t ea = {}; PPC_STORE_U64(ea, {}.u64); {}.u32 = ea; }}", eaIndexed(), f(rd), r(ra));
+            return true;
+        case 597: case 725: // lswi, stswi

+        if (xo9 == 8) // subfc with OE (subfco)
+        {
+            println("\tctx.xer.ca = {}.u32 >= {}.u32;", r(rb), r(ra));
+            println("\t{}.s64 = {}.s64 - {}.s64;", r(rd), r(rb), r(ra));
+            if (word & 1)
+                println("\tctx.cr0.compare<int32_t>({}.s32, 0, ctx.xer);", r(rd));
+            return true;
+        }
+    }
+
+    return false;
+}
+
+bool Recompiler::FillsPairedSingle(int id)
+{
+    // With paired singles enabled (HID2[PSE]), single-precision results and lfs also write ps1.
+    switch (id)
+    {
+    case PPC_INST_LFS:
+    case PPC_INST_LFSU:
+    case PPC_INST_LFSX:
+    case PPC_INST_LFSUX:
+    case PPC_INST_FADDS:
+    case PPC_INST_FSUBS:
+    case PPC_INST_FMULS:
+    case PPC_INST_FDIVS:
+    case PPC_INST_FMADDS:
+    case PPC_INST_FMSUBS:
+    case PPC_INST_FNMADDS:
+    case PPC_INST_FNMSUBS:
+    case PPC_INST_FRES:
+    case PPC_INST_FRSP:
+        return true;
+    default:
+        return false;
+    }
+}
